{
  "description": "hojokin の hooks。会社のフォルダの目印（.hojokin/）がなければ何もしない。Python が動かないか時間内に終わらないときは、書き込み・Bash・ブラウザの道具・claude.ai に上げる道具を拒み、開いたときに準備の案内を渡す。会社のフォルダの外を読む道具も拒む",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" SessionStart", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" UserPromptSubmit", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit|Bash)$|Claude_Browser|claude-in-chrome|computer-use|^Artifact(Comments|Data)?$",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PreToolUse guard", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|NotebookRead|Grep|Glob|LS",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PreToolUse", "timeout": 10 }
        ]
      },
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PreToolUse handback", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(Claude_Browser|claude-in-chrome)__|^AskUserQuestion$",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PostToolUse", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" Stop", "timeout": 60 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^hojokin:shinsa$",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" SubagentStop", "timeout": 10 }
        ]
      }
    ]
  }
}
