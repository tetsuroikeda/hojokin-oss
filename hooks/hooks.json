{
  "description": "hojokin の hooks。会社のフォルダの目印（.hojokin/）がなければ何もしない。Python が動かないときは、書き込みとブラウザの操作を拒む",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" SessionStart", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" UserPromptSubmit", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$|Claude_Browser|claude-in-chrome|computer-use",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PreToolUse guard", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(Claude_Browser|claude-in-chrome)__",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PostToolUse", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" Stop", "timeout": 60 }
        ]
      }
    ]
  }
}
