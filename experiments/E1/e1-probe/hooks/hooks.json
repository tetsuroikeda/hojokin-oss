{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" UserPromptSubmit" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(Claude_Browser|claude-in-chrome|computer-use)__",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PreToolUse" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(Claude_Browser|claude-in-chrome|computer-use)__",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" PostToolUse" }
        ]
      }
    ]
  }
}
